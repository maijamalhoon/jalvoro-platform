  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run brand:sync",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:ci": "node scripts/dependency-audit-policy.mts",
    "brand:sync": "node scripts/sync-brand.mjs",
    "check": "npm run check:brand && npm run lint && npm run typecheck && npm test",
    "check:brand": "node scripts/sync-brand.mjs --check && node scripts/check-brand.mjs",
    "test:ui": "vitest run lib/theme.test.ts",
    "test:analytics": "vitest run lib/analytics/calculations.test.ts",
    "test:settings": "vitest run lib/settings/security.test.ts",
    "test:session": "vitest run lib/supabase/session.test.ts",
    "test:e2e": "node scripts/run-local-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@base-ui/react": "^1.5.0",
    "@sentry/nextjs": "^10.60.0",
